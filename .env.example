# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=apm_demo
MYSQL_USER=apm
MYSQL_PASSWORD=1234
MYSQL_HOST=localhost
# 로컬에 mysqld가 이미 3306을 점유 중이면 13306 등으로 변경 (compose 포트 매핑과 앱 접속에 동시 적용)
MYSQL_PORT=3306

# OTel Collector (호스트 포트가 점유 중이면 변경)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Kafka (호스트에서 접속하는 EXTERNAL 리스너 포트)
KAFKA_PORT=9092

# kafka-ui (웹 접속 호스트 포트 — 8080은 로컬 Spring Boot·타 컨테이너와 충돌 잦아 8081 사용)
KAFKA_UI_PORT=8081

# ClickHouse (호스트 포트가 점유 중이면 변경)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=otel
CLICKHOUSE_USER=apm
CLICKHOUSE_PASSWORD=1234
